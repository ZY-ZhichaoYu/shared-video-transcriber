# 本地 Docker 登录使用；真实值从 Infisical dev 的本应用目录读取。
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=douyin-transcriber-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PROFILE_ENCRYPTION_KEY=
R2_PROFILE_PREFIX=profiles/douyin
NETWORK_MODE=direct
# CI 使用 tailscale；检查大陆出口失败就停止。
TAILSCALE_EXPECTED_IP=
TAILSCALE_EXIT_NODE=armbian
TAILSCALE_TAGS=tag:ci
TS_OAUTH_CLIENT_ID=
TS_OAUTH_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
