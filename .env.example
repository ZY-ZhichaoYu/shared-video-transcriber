# Optional. Copy this file to .env, fill only what you need, then restart.
# Never publish .env or your API key. Ordinary transcription needs no API key.
#
# VIDEO_AI_BASE_URL=https://your-provider.example/v1
# VIDEO_AI_MODEL=your-model-name
# VIDEO_AI_API_KEY=your-key
#
# Optional local storage / port:
# VIDEO_DATA_DIR=E:/VideoInboxData
# VIDEO_PORT=7860
# VIDEO_OPEN_BROWSER=0
#
# Process environment variables take priority over this file.
